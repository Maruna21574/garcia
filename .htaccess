Options -Indexes
ErrorDocument 404 /404.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^(www\.)?targos\.sk(?::\d+)?$ [NC]
    RewriteRule ^ https://garcia.sk%{REQUEST_URI} [L,R=301,NE]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|.*\.test)(:\d+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
    RewriteRule ^index\.php$ / [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+admin/index\.php(?:[?\s]) [NC]
    RewriteRule ^admin/index\.php$ /admin/ [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+sluzby\.php(?:[?\s]) [NC]
    RewriteRule ^sluzby\.php$ /sluzby [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+realizacie\.php(?:[?\s]) [NC]
    RewriteRule ^realizacie\.php$ /realizacie [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+o-nas\.php(?:[?\s]) [NC]
    RewriteRule ^o-nas\.php$ /o-nas [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+kontakt\.php(?:[?\s]) [NC]
    RewriteRule ^kontakt\.php$ /kontakt [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+realizacia-chata\.php(?:[?\s]) [NC]
    RewriteRule ^realizacia-chata\.php$ /realizacia-chata [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+ochrana-sukromia\.php(?:[?\s]) [NC]
    RewriteRule ^ochrana-sukromia\.php$ /ochrana-sukromia [R=301,L,NE]

    RewriteRule ^(sluzby|realizacie|o-nas|kontakt|realizacia-chata|ochrana-sukromia)/$ /$1 [R=301,L,NE]
    RewriteRule ^sluzby/?$ sluzby.php [END,QSA]
    RewriteRule ^realizacie/?$ realizacie.php [END,QSA]
    RewriteRule ^o-nas/?$ o-nas.php [END,QSA]
    RewriteRule ^kontakt/?$ kontakt.php [END,QSA]
    RewriteRule ^realizacia-chata/?$ realizacia-chata.php [END,QSA]
    RewriteRule ^ochrana-sukromia/?$ ochrana-sukromia.php [END,QSA]

    # Serve the pre-generated WebP twin (photo.jpg -> photo.jpg.webp) to browsers that accept it.
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME}.webp -f
    RewriteRule ^(assets/.+\.jpe?g)$ $1.webp [T=image/webp,L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|webp)$">
        Header merge Vary Accept
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

AddType image/webp .webp

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/xhtml+xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
